{
  "_version": "1.59.0",
  "sap.app": {
    "id": "cap.reply.fioriui",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:fpm",
      "version": "1.14.4",
      "toolsId": "cdd8027c-3497-4241-aba2-c61fa061a9df"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/planner/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "BudgetInfo-getBudget": {
          "semanticObject": "BudgetInfo",
          "action": "getBudget",
          "title": "{{flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.127.1",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ushell": {},
        "sap.fe.templates": {},
        "sap.fe.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "cap.reply.fioriui.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "name": "BudgetList",
          "pattern": ":?query:",
          "target": "BudgetList"
        },
        {
          "name": "BudgetObjectPage",
          "pattern": "Budget({BudgetKey}):?query:",
          "target": "BudgetObjectPage"
        },
        {
          "name": "BudgetSubPage",
          "pattern": "Budget({BudgetKey}):?query:",
          "target": "BudgetObjectPage"
        }
      ],
      "targets": {
        "BudgetList": {
          "type": "Component",
          "id": "BudgetList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "navigation": {
                "Budget": {
                  "detail": {
                    "route": "BudgetObjectPage"
                  }
                }
              },
              "contextPath": "/Budget",
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "selectionMode": "Single",
                    "personalization": {
                      "filter": true,
                      "sort": true
                    }
                  }
                }
              }
            }
          }
        },
        "BudgetObjectPage": {
          "type": "Component",
          "id": "BudgetObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "navigation": {},
              "contextPath": "/Budget",
              "additionalSemanticObjects": {},
              "controlConfiguration": {
                "childBudgets/@com.sap.vocabularies.UI.v1.LineItem#ChildBudgets": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "selectionMode": "Single"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
